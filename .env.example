# =======================================================
# Plantilla de Variables de Entorno (Ejemplo para el Repo)
# Copia este archivo como .env y ajusta los valores necesarios
# =======================================================

# Puerto en el que escucha el servicio interno
PORT=80

# Usuario y grupo del sistema bajo el que corre la aplicación
APP_USER=balancer
APP_GROUP=balancer

# Configuración futura de endpoints de backends
# BACKEND_PYTHON_URL=http://backend-python:9001
# BACKEND_JAVA_URL=http://backend-java:9002
