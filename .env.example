# =======================================================
# Plantilla de Variables de Entorno (Ejemplo para el Repo)
# Copia este archivo como .env y ajusta los valores necesarios
# =======================================================

# Puerto del Windows que publica el balanceador HTTP (internamente escucha en 80)
PUBLIC_PORT=89

# Usuario y grupo del sistema bajo el que corre la aplicación
APP_USER=balancer
APP_GROUP=balancer

# Carpeta persistente donde SCP recibe archivos
DEPLOY_DIR=/deploy

# Backends gRPC ejecutándose dentro del mismo contenedor que el balanceador.
OLD_BACKEND_URL=http://127.0.0.1:9001
NEW_BACKEND_URL=http://127.0.0.1:9002

# Puerto de Windows que se publica hacia el SSH del contenedor
SCP_PORT=2222
