# =======================================================
# Plantilla de Variables de Entorno (Ejemplo para el Repo)
# Copia este archivo como .env y ajusta los valores necesarios
# =======================================================

# Puerto HTTP público del balanceador
PORT=80

# Usuario y grupo del sistema bajo el que corre la aplicación
APP_USER=balancer
APP_GROUP=balancer

# Carpeta persistente donde SCP recibe archivos
DEPLOY_DIR=/deploy

# Backends gRPC de Etapa 1 ejecutándose en el Windows anfitrión.
# vieja y nueva son dos procesos independientes, no dos carpetas del balanceador.
# Las apps deben escuchar en 0.0.0.0:9001 y 0.0.0.0:9002.
OLD_BACKEND_URL=http://host.docker.internal:9001
NEW_BACKEND_URL=http://host.docker.internal:9002

# Para Etapa 2 se puede ampliar la lista con todas las réplicas saludables.
# BACKENDS=http://host.docker.internal:9001,http://host.docker.internal:9002
HEALTH_CHECK_INTERVAL=5

# Puerto de Windows que se publica hacia el SSH del contenedor
SCP_PORT=2222
